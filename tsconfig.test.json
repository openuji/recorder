{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "paths": {
      "@openuji/core": ["./packages/core/src/index.ts"],
      "@openuji/engine": ["./packages/engine/src/index.ts"],
      "@openuji/rules-document": ["./packages/rules-document/src/index.ts"],
      "@openuji/rules-interaction": ["./packages/rules-interaction/src/index.ts"],
      "@openuji/sinks": ["./packages/sinks/src/index.ts"]
    }
  },
  "include": ["packages/**/test/**/*.ts", "apps/**/test/**/*.ts", "vitest.config.ts"]
}
