---
import type { MainLandingPage } from "../content/types";
import SiteShell from "../components/layout/SiteShell.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import FeatureGrid from "../components/sections/FeatureGrid.astro";
import JourneyExample from "../components/journey/JourneyExample.astro";
import PilotCards from "../components/sections/PilotCards.astro";
import CallToAction from "../components/sections/CallToAction.astro";
interface Props { page: MainLandingPage; }
const { page } = Astro.props;
---
<SiteShell meta={page.meta}>
  <Header content={page.header} />
  <main id="main-content">
    <Hero content={page.hero} />
    <FeatureGrid id="how-it-works" eyebrow={page.features.eyebrow} title={page.features.title} intro={page.features.intro} items={page.features.items} />
    <JourneyExample id="ujg" content={page.journey} />
    <PilotCards id="pilots" eyebrow={page.pilots.eyebrow} title={page.pilots.title} intro={page.pilots.intro} items={page.pilots.items} />
    <CallToAction content={page.cta} ribbonId="main-cta" />
  </main>
  <Footer content={page.footer} />
</SiteShell>
