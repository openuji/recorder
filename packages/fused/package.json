{
  "name": "@uxr/fused",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orchestrator: multiplexes the three independent streams into one ordered domain event stream.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "uxr-stream-fused": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --build",
    "dev": "node dist/cli.js"
  },
  "dependencies": {
    "@uxr/cli-kit": "workspace:*",
    "@uxr/core": "workspace:*",
    "@uxr/engine": "workspace:*",
    "@uxr/rules-document": "workspace:*",
    "@uxr/rules-interaction": "workspace:*",
    "@uxr/sinks": "workspace:*",
    "@uxr/stream-compositor": "workspace:*",
    "@uxr/stream-interaction": "workspace:*",
    "@uxr/stream-lifecycle": "workspace:*",
    "playwright": "^1.63.0"
  }
}
