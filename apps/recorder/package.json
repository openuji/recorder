{
  "name": "@uxr/recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end UXR capture session: fused streams through the rules engine into configured sinks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "uxr-record": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@uxr/cli-kit": "workspace:*",
    "@uxr/core": "workspace:*",
    "@uxr/engine": "workspace:*",
    "@uxr/fused": "workspace:*",
    "@uxr/rules-document": "workspace:*",
    "@uxr/rules-interaction": "workspace:*",
    "@uxr/sinks": "workspace:*",
    "playwright": "^1.63.0"
  }
}
