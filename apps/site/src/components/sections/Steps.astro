---
import type { StepItem } from "../../content/types";
import Container from "../primitives/Container.astro";
import SectionHeading from "../primitives/SectionHeading.astro";
import Section from "../layout/Section.astro";
interface Props { id?: string; eyebrow?: string; title: string; intro?: string; items: StepItem[]; }
const { id, eyebrow, title, intro, items } = Astro.props;
---
<Section id={id}>
  <Container>
    <SectionHeading eyebrow={eyebrow} title={title} intro={intro} />
    <ol class="mt-14 grid gap-0 border-t border-line">
      {items.map((item) => (
        <li class="grid gap-5 border-b border-line py-6 md:grid-cols-[7rem_16rem_1fr] md:items-start md:py-8">
          <span class="text-label font-bold uppercase tracking-[0.12em] text-ink-muted">{item.number}</span>
          <h3 class="text-title font-black tracking-[-0.03em]">{item.title}</h3>
          <p class="max-w-[58ch] text-body text-ink-muted">{item.body}</p>
        </li>
      ))}
    </ol>
  </Container>
</Section>
