{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    // Browser bundles are emitted by esbuild (see build-client.mjs); tsc only
    // typechecks this tier.
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false
  }
}
