---
import type { PilotLandingPage } from "../content/types";
import SiteShell from "../components/layout/SiteShell.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Steps from "../components/sections/Steps.astro";
import ExampleTasks from "../components/sections/ExampleTasks.astro";
import Statement from "../components/sections/Statement.astro";
import Principles from "../components/sections/Principles.astro";
import CallToAction from "../components/sections/CallToAction.astro";
interface Props { page: PilotLandingPage; }
const { page } = Astro.props;
---
<SiteShell meta={page.meta}>
  <Header content={page.header} variant="pilot" />
  <main id="main-content">
    <Hero content={page.hero} variant="pilot" />
    <Steps id="how-it-works" eyebrow={page.steps.eyebrow} title={page.steps.title} intro={page.steps.intro} items={page.steps.items} />
    <ExampleTasks eyebrow={page.tasks.eyebrow} title={page.tasks.title} intro={page.tasks.intro} items={page.tasks.items} note={page.tasks.note} />
    <Statement id="why" content={page.statement} />
    <Principles eyebrow={page.principles.eyebrow} title={page.principles.title} intro={page.principles.intro} items={page.principles.items} />
    <CallToAction content={page.cta} ribbonId="pilot-cta" />
  </main>
  <Footer content={page.footer} />
</SiteShell>
